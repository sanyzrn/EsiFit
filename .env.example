# ---------------------------------------------------------------
# EsiFit — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------

# PostgreSQL connection string.
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Special characters in the password must be percent-encoded (@ -> %40).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/esifit"

# Separate throwaway database used by `bun run test` — the suite wipes every
# table between tests, so never point this at your development database.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/esifit_test"

# REQUIRED in production. The server refuses to sign sessions without it.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=""

# Absolute public origin — canonical URLs, og:url, robots.txt and sitemap.xml
# are all built from this. Without it they fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMS adapter: dev | kavenegar | melipayamak | smsir
# "dev" prints the OTP to the server log instead of sending a message.
SMS_PROVIDER="dev"

# Public demo mode (never use with real customer phone numbers).
# Only these seeded, throwaway accounts may request/see OTP on the public site:
ESIFIT_DEMO_MODE="false"
ESIFIT_DEMO_PHONES="09120000000"

# --- Kavenegar ---
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""

# --- Melipayamak ---
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
MELIPAYAMAK_OTP_BODY_ID=""

# --- SMS.ir ---
SMSIR_API_KEY=""
SMSIR_LINE=""
SMSIR_OTP_TEMPLATE_ID=""

# Feature-flag overrides, e.g. ESIFIT_FLAG_AI_CHAT=off

# Optional stable AI encryption secret. Empty uses SESSION_SECRET for compatibility.
# Set before adding providers; changing either active encryption key requires re-entering provider keys.
AI_ENCRYPTION_SECRET=""

# Explicit opt-in for mock checkout/subscriptions in production test deployments.
ALLOW_MOCK_PAYMENT="false"

# Self-host only: trust the last X-Forwarded-For value only when your ingress
# overwrites/appends it and direct access to the app is blocked. Vercel is automatic.
TRUST_PROXY="false"

# Public previews/staging MUST run a production build with NODE_ENV=production.
# Local development intentionally returns dev OTPs. Never expose next dev publicly.
