# ---------------------------------------------------------------
# EsiFit — environment template. Copy to .env and fill in.
#   cp .env.example .env
#
# In production these must be REAL environment variables set by the host
# (panel / systemd / pm2 / docker). The build strips .env out of the
# standalone artifact on purpose, so a stray local .env never ships.
# ---------------------------------------------------------------

# MySQL / MariaDB connection string.
#   mysql://USER:PASSWORD@HOST:3306/DATABASE
# On shared hosting the user, password and database name come from the panel.
# Special characters in the password must be percent-encoded (@ -> %40).
DATABASE_URL="mysql://esifit:password@127.0.0.1:3306/esifit"

# REQUIRED in production. The server refuses to sign sessions without it.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=""

# Absolute public origin — canonical URLs, og:url, robots.txt and sitemap.xml
# are all built from this. Without it they fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://example.com"

# SMS adapter: dev | kavenegar | melipayamak | smsir
# "dev" prints the OTP to the server log instead of sending a message.
SMS_PROVIDER="dev"

# --- Kavenegar ---
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""

# --- Melipayamak ---
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
MELIPAYAMAK_OTP_BODY_ID=""

# --- SMS.ir ---
SMSIR_API_KEY=""
SMSIR_LINE=""
SMSIR_OTP_TEMPLATE_ID=""

# Test suite only: MySQL used by `bun run test` (never your real database —
# the suite wipes it between tests).
TEST_DATABASE_URL="mysql://esifit:password@127.0.0.1:3306/esifit_test"

# Feature-flag overrides, e.g. ESIFIT_FLAG_AI_CHAT=off
